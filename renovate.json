{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": ["main"],
  "kubernetes": {
    "fileMatch": ["\\.yaml$"]
  },
  "helmv3": {
    "fileMatch": ["argocd/.+\\.yaml$"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch updates for container images",
      "matchUpdateTypes": ["patch", "digest"],
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group all Helm chart updates",
      "matchDatasources": ["helm"],
      "groupName": "helm-charts"
    },
    {
      "description": "Pin latest tags to digests for reproducibility",
      "matchCurrentValue": "latest",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Nextcloud only supports upgrading one major version at a time and migrates its DB on every bump. Never auto-merge it, and raise one PR per major so 35 -> 36 -> 37 can't be skipped.",
      "matchPackageNames": ["nextcloud"],
      "matchDatasources": ["docker"],
      "automerge": false,
      "separateMultipleMajor": true
    },
    {
      "description": "linuxserver tags embed a build hash (1.43.5.11079-b3b13e506-ls330); compare on the numeric parts only.",
      "matchPackageNames": ["linuxserver/plex"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+-ls(?<revision>\\d+)$"
    },
    {
      "description": "SearXNG tags are date + commit (2026.10.30-ffa88e3ba).",
      "matchPackageNames": ["searxng/searxng"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]+$"
    },
    {
      "description": "Apps that migrate their own database on upgrade: never auto-merge, not even patches or digests (Open WebUI tracks :main, so every update is a digest bump).",
      "matchPackageNames": ["ghcr.io/paperless-ngx/paperless-ngx", "ghcr.io/mealie-recipes/mealie", "freshrss/freshrss", "ghcr.io/open-webui/open-webui"],
      "automerge": false
    },
    {
      "description": "Block major upgrades for stateful services (require manual DB migration)",
      "matchPackageNames": ["postgres", "redis"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "schedule": ["before 8am on Monday"],
  "timezone": "Europe/Dublin",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10
}
